<?xml version="1.0" encoding="UTF-8"?>

<?import com.comp2042.ui.GameOverPanel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<StackPane fx:id="viewRoot"
           fx:controller="com.comp2042.ui.GuiController"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           style="-fx-background-color: linear-gradient(to bottom, #1a1a2e 0%, #16213e 100%);">

    <HBox alignment="CENTER" spacing="30">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <VBox spacing="20" alignment="TOP_CENTER" minWidth="180" style="-fx-padding: 200 0 0 0;">
            <Label text="LEVEL" styleClass="level-title-glow"/>
            <HBox alignment="CENTER">
                <Label fx:id="levelLabel" text="1" prefWidth="100" prefHeight="80" alignment="CENTER" styleClass="level-display"/>
            </HBox>
            <VBox spacing="8" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Label text="CONTROLS" styleClass="controls-title"/>
                <Label text="← → Move" styleClass="control-text"/>
                <Label text="↑ Rotate" styleClass="control-text"/>
                <Label text="↓ Soft Drop" styleClass="control-text"/>
                <Label text="SPACE Hard Drop" styleClass="control-text"/>
            </VBox>
        </VBox>

        <VBox spacing="15" alignment="CENTER">

            <!-- Enhanced Mode Display Box -->
            <StackPane styleClass="mode-container" alignment="CENTER" maxWidth="220"
                       style="-fx-background-color: linear-gradient(to right, rgba(255, 215, 0, 0.15), rgba(255, 165, 0, 0.15));
                              -fx-background-radius: 12;
                              -fx-padding: 12 15 12 15;
                              -fx-effect: dropshadow(gaussian, rgba(255, 215, 0, 0.4), 15, 0, 0, 0);
                              -fx-border-color: rgba(255, 215, 0, 0.7);
                              -fx-border-width: 3;
                              -fx-border-radius: 12;">

                <VBox alignment="CENTER" spacing="3">
                    <Label fx:id="modeNameLabel" text="MODE: SELECTING..." alignment="CENTER"
                           style="-fx-text-fill: #FFD700;
                                  -fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-effect: dropshadow(gaussian, rgba(255, 215, 0, 0.8), 6, 0, 0, 0);
                                  -fx-alignment: center;"/>

                    <Label fx:id="modeDetailsLabel" text="Ready" alignment="CENTER"
                           style="-fx-text-fill: #FFA500;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-font-style: italic;
                                  -fx-effect: dropshadow(gaussian, rgba(255, 165, 0, 0.6), 4, 0, 0, 0);
                                  -fx-alignment: center;"/>
                </VBox>
            </StackPane>

            <StackPane styleClass="score-container" alignment="CENTER">
                <Label fx:id="scoreLabel" text="0" styleClass="score-display"/>
            </StackPane>

            <StackPane fx:id="gameContainer">
                <BorderPane fx:id="gameBoard" styleClass="gameBoard" prefWidth="212" maxWidth="212" prefHeight="412">
                    <center>
                        <StackPane style="-fx-padding: 0; -fx-background-color: transparent;">
                            <GridPane fx:id="gamePanel" hgap="0" vgap="0" alignment="CENTER"
                                      prefWidth="200" maxWidth="200" prefHeight="400" maxHeight="400"
                                      style="-fx-padding: 0;"/>
                        </StackPane>
                    </center>
                </BorderPane>

                <Pane fx:id="particlePane" mouseTransparent="true"
                      prefWidth="200" prefHeight="400"
                      style="-fx-background-color: transparent;"/>

                <StackPane fx:id="groupNotification" visible="true" mouseTransparent="true">
                    <GameOverPanel fx:id="gameOverPanel"/>
                </StackPane>
            </StackPane>

            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="pauseButton" text="PAUSE" minWidth="100" prefHeight="45"
                        onAction="#pauseGame" styleClass="game-button"/>
                <Button text="RESTART" minWidth="100" prefHeight="45"
                        onAction="#newGame" styleClass="game-button"/>
                <Button text="MENU" minWidth="100" prefHeight="45"
                        onAction="#backToMainMenu" styleClass="game-button"/>
            </HBox>
        </VBox>

        <VBox spacing="20" alignment="TOP_CENTER" minWidth="180" style="-fx-padding: 200 0 0 0;">
            <Label text="NEXT" styleClass="next-title-glow"/>
            <HBox alignment="CENTER">
                <VBox alignment="CENTER" spacing="0" styleClass="next-piece-container" prefWidth="100" prefHeight="80">
                    <padding>
                        <Insets top="5" bottom="5" left="5" right="5"/>
                    </padding>
                    <StackPane alignment="CENTER">
                        <GridPane fx:id="nextGrid" alignment="CENTER" hgap="1" vgap="1"/>
                    </StackPane>
                </VBox>
            </HBox>
        </VBox>

    </HBox>

    <stylesheets>
        <URL value="@../window_style.css"/>
    </stylesheets>
</StackPane>